<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_preview"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="4dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="PDF Preview"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tv_preview_template_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_pill"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="Modern Pro"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_copy_plain_text"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Copy Plain Text for Job Portals"
                android:src="@drawable/ic_content_copy"
                app:tint="@color/primary" />

            <ImageButton
                android:id="@+id/btn_preview_share"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Share PDF"
                android:src="@drawable/ic_share"
                app:tint="@color/primary" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Quick Live Template & Color Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_templates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Palette Accent:"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <View
                android:id="@+id/preview_dot_blue"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_color_dot"
                android:backgroundTint="@color/theme_blue" />

            <View
                android:id="@+id/preview_dot_emerald"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_color_dot"
                android:backgroundTint="@color/theme_emerald" />

            <View
                android:id="@+id/preview_dot_purple"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_color_dot"
                android:backgroundTint="@color/theme_purple" />

            <View
                android:id="@+id/preview_dot_crimson"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_color_dot"
                android:backgroundTint="@color/theme_crimson" />

            <View
                android:id="@+id/preview_dot_slate"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_color_dot"
                android:backgroundTint="@color/theme_slate" />

            <View
                android:id="@+id/preview_dot_amber"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_color_dot"
                android:backgroundTint="@color/theme_amber" />
        </LinearLayout>
    </LinearLayout>

    <!-- PDF Page View Carousel / ViewPager -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#334155"
        android:padding="16dp">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_pdf_pages"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/pb_pdf_rendering"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_pill"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="Page 1 of 1"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Bottom Actions Bar: Export PDF, Print, Edit Resume -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preview_edit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Edit Resume"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_edit"
            app:iconSize="16dp"
            app:iconTint="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preview_export"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:text="Export PDF"
            android:textColor="@color/on_primary"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_picture_as_pdf"
            app:iconSize="16dp"
            app:iconTint="@color/on_primary" />
    </LinearLayout>

</LinearLayout>

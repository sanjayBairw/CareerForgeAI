<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_editor"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="4dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Edit Resume"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tv_autosave_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="Saved"
                android:textColor="@color/accent_ats"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_undo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Undo"
                android:src="@drawable/ic_undo"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btn_redo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Redo"
                android:src="@drawable/ic_redo"
                app:tint="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_editor_preview"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/primary"
                android:text="Preview"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_picture_as_pdf"
                app:iconSize="14dp"
                app:iconTint="@color/on_primary" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Tabs: Personal, Summary, Experience, Education, Skills, Projects, Design -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_editor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:tabIndicatorColor="@color/primary"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/primary"
        app:tabTextColor="@color/text_secondary" />

    <!-- Container for Tab View Content -->
    <FrameLayout
        android:id="@+id/container_step_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CareerForge" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">#3B82F6</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#1E3A8A</item>
        <item name="colorOnPrimaryContainer">#DBEAFE</item>

        <item name="colorSecondary">#E2E8F0</item>
        <item name="colorOnSecondary">#0F172A</item>
        <item name="colorSecondaryContainer">#1E293B</item>
        <item name="colorOnSecondaryContainer">#F8FAFC</item>

        <!-- Dark Background & Surface -->
        <item name="android:colorBackground">#0B0F19</item>
        <item name="colorSurface">#111827</item>
        <item name="colorSurfaceVariant">#1E293B</item>

        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">#111827</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#111827</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Bottom Navigation Style -->
        <item name="bottomNavigationStyle">@style/Widget.CareerForge.BottomNavigation</item>
    </style>

    <style name="Widget.CareerForge.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="elevation">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.CareerForge.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">#1E293B</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">#111827</item>
    </style>
</resources>
